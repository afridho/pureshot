{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PureShot",
  "version": "0.1.0",
  "identifier": "com.pureshot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [{
      "title": "PureShot",
      "width": 1120,
      "height": 720,
      "minWidth": 820,
      "minHeight": 590,
      "center": true,
      "visible": false,
      "decorations": false,
      "transparent": false,
      "backgroundColor": "#f7f8fa"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
